<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>排球接球王</title>

<style>
body{
    margin:0;
    background:#87CEEB;
    font-family:Arial, sans-serif;
    text-align:center;
}

h1{
    color:white;
}

#gameArea{
    width:100%;
    max-width:800px;
    height:500px;
    margin:auto;
    background:#f5f5f5;
    border:5px solid #333;
    position:relative;
    overflow:hidden;
}

#partner{
    position:absolute;
    bottom:40px;
    left:50%;
    transform:translateX(-50%);
    font-size:70px;
}

#ball{
    position:absolute;
    font-size:40px;
    display:none;
    transition:all linear;
}

#scoreBoard{
    margin:15px;
    font-size:24px;
    font-weight:bold;
}

.controls{
    margin-top:20px;
}

button{
    width:100px;
    height:60px;
    font-size:20px;
    margin:5px;
    cursor:pointer;
}

.topRow{
    display:flex;
    justify-content:center;
}

.bottomRow{
    display:flex;
    justify-content:center;
}

#message{
    font-size:28px;
    color:red;
    margin-top:10px;
}
</style>
</head>

<body>

<h1>🏐 排球接球王</h1>

<div id="scoreBoard">
分數：<span id="score">0</span>
｜
連擊：<span id="combo">0</span>
</div>

<div id="gameArea">
    <div id="ball">🏐</div>
    <div id="partner">🧍‍♂️</div>
</div>

<div id="message"></div>

<br>

<button onclick="startGame()">開始遊戲</button>

<div class="controls">

<div class="topRow">
<button onclick="playerAction('leftUp')">↖</button>
<button onclick="playerAction('up')">↑</button>
<button onclick="playerAction('rightUp')">↗</button>
</div>

<div class="bottomRow">
<button onclick="playerAction('leftDown')">↙</button>
<button onclick="playerAction('down')">↓</button>
<button onclick="playerAction('rightDown')">↘</button>
</div>

</div>

<script>

let score = 0;
let combo = 0;
let currentDirection = null;
let gameRunning = false;
let timeoutId;

const ball = document.getElementById("ball");

const directions = [
    "leftUp",
    "rightUp",
    "leftDown",
    "rightDown",
    "up",
    "down"
];

const speedMap = {
    slow:2000,
    medium:1300,
    fast:800
};

function startGame(){

    score = 0;
    combo = 0;

    updateUI();

    document.getElementById("message").innerHTML="";

    gameRunning = true;

    spawnBall();
}

function spawnBall(){

    if(!gameRunning) return;

    currentDirection =
        directions[Math.floor(Math.random()*directions.length)];

    const speeds = ["slow","medium","fast"];
    const speed =
        speeds[Math.floor(Math.random()*3)];

    const duration = speedMap[speed];

    let startX = 350;
    let startY = 50;

    switch(currentDirection){

        case "leftUp":
            startX = 150;
            startY = 50;
            break;

        case "rightUp":
            startX = 550;
            startY = 50;
            break;

        case "leftDown":
            startX = 150;
            startY = 250;
            break;

        case "rightDown":
            startX = 550;
            startY = 250;
            break;

        case "up":
            startX = 350;
            startY = 30;
            break;

        case "down":
            startX = 350;
            startY = 300;
            break;
    }

    ball.style.display="block";
    ball.style.transition="none";
    ball.style.left=startX+"px";
    ball.style.top=startY+"px";

    void ball.offsetWidth;

    ball.style.transition=`all ${duration}ms linear`;
    ball.style.left="350px";
    ball.style.top="200px";

    timeoutId = setTimeout(()=>{
        gameOver();
    }, duration);
}

function playerAction(action){

    if(!gameRunning) return;

    if(action === currentDirection){

        clearTimeout(timeoutId);

        combo++;

        let addScore = 1;

        if(combo >= 20)
            addScore = 5;
        else if(combo >= 10)
            addScore = 3;
        else if(combo >= 5)
            addScore = 2;

        score += addScore;

        updateUI();

        spawnBall();

    }else{

        gameOver();
    }
}

function updateUI(){

    document.getElementById("score").innerHTML=score;
    document.getElementById("combo").innerHTML=combo;
}

function gameOver(){

    gameRunning = false;

    ball.style.display="none";

    document.getElementById("message").innerHTML =
        `遊戲結束！最終分數：${score}`;
}

</script>

</body>
</html>
